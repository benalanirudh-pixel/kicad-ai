# --------------------------------------------------------------------------- unresolved vs conflicting


class TestUnresolvedAndConflicting(unittest.TestCase):
    """Unresolved and conflicting facts must block gates."""

    def test_unresolved_u1_blocks_electrical(self):
        profile = make_profile({"U1": HardwareFact(confidence=CONFIDENCE_UNRESOLVED)})
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)
        self.assertIn("U1", result.blocking_assumptions)
        self.assertIn("unresolved", result.reason.lower())

    def test_conflicting_u2_blocks_electrical(self):
        profile = make_profile({
            "U2": HardwareFact(
                confidence=CONFIDENCE_CONFLICTING,
                value="GPIO21",
                source="prompt_extract",
            ),
        })
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)
        self.assertIn("U2", result.blocking_assumptions)
        self.assertGreaterEqual(len(result.conflicts), 1)

    def test_conflicting_u4_blocks_mechanical(self):
        profile = make_profile({
            "U4": HardwareFact(
                confidence=CONFIDENCE_CONFLICTING,
                value="2.54mm",
                source="datasheet",
            ),
        })
        result = gate_mechanical_footprint(profile)
        self.assertFalse(result.allowed)
        self.assertIn("U4", result.blocking_assumptions)

    def test_all_unresolved_blocks_fabrication(self):
        profile = make_profile({})
        result = gate_fabrication_release(profile)
        self.assertFalse(result.allowed)
        self.assertEqual(
            set(result.blocking_assumptions), {"U1", "U2", "U3", "U4", "U5", "U6", "U7"}
        )


# --------------------------------------------------------------------------- assumed vs verified


class TestAssumedVsVerified(unittest.TestCase):
    """Explicitly assumed facts may pass gates; verified facts always pass."""

    def test_assumed_u1_passes_electrical(self):
        # U1 assumed by user — allowed to proceed with user sign-off recorded.
        profile = make_profile({
            "U1": HardwareFact(
                value="3.3V-5V",
                source="user_selection",
                confidence=CONFIDENCE_ASSUMED,
                affects_decisions=["supply_net_selection"],
            ),
            "U2": HardwareFact(
                value="GPIO21",
                source="user_selection",
                confidence=CONFIDENCE_ASSUMED,
                affects_decisions=["schematic_wiring"],
            ),
            "U3": HardwareFact(
                value=True,
                source="user_selection",
                confidence=CONFIDENCE_ASSUMED,
                affects_decisions=["schematic_resistors"],
            ),
            "U7": HardwareFact(
                value="0x76",
                source="user_selection",
                confidence=CONFIDENCE_ASSUMED,
                affects_decisions=["schematic_nets"],
            ),
        })
        result = gate_electrical_schematic(profile)
        self.assertTrue(result.allowed)
        self.assertEqual(result.blocking_assumptions, [])
        self.assertIn("resolved", result.reason.lower())

    def test_verified_u1_passes_electrical(self):
        profile = make_profile({
            "U1": HardwareFact(
                value="3.3V-5V",
                source="datasheet",
                confidence=CONFIDENCE_VERIFIED,
                affects_decisions=["supply_net_selection"],
                evidence_date="2026-10-25",
            ),
            "U2": HardwareFact(
                value="GPIO21",
                source="datasheet",
                confidence=CONFIDENCE_VERIFIED,
                affects_decisions=["schematic_wiring"],
                evidence_date="2026-10-25",
            ),
            "U3": HardwareFact(
                value=True,
                source="datasheet",
                confidence=CONFIDENCE_VERIFIED,
                affects_decisions=["schematic_resistors"],
                evidence_date="2026-10-25",
            ),
            "U7": HardwareFact(
                value="0x76",
                source="datasheet",
                confidence=CONFIDENCE_VERIFIED,
                affects_decisions=["schematic_nets"],
                evidence_date="2026-10-25",
            ),
        })
        result = gate_electrical_schematic(profile)
        self.assertTrue(result.allowed)

    def test_mix_assumed_and_unresolved_blocks(self):
        profile = make_profile({
            "U1": HardwareFact(confidence=CONFIDENCE_ASSUMED),
            "U2": HardwareFact(confidence=CONFIDENCE_UNRESOLVED),
            "U3": HardwareFact(confidence=CONFIDENCE_ASSUMED),
            "U7": HardwareFact(confidence=CONFIDENCE_ASSUMED),
        })
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)
        self.assertIn("U2", result.blocking_assumptions)


