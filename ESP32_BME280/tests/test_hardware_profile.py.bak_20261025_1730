# --------------------------------------------------------------------------- helpers


def write_profile(tmpdir: str, data: dict) -> Path:
    """Write a profile JSON file to a temp directory and return its path."""
    p = Path(tmpdir) / "hardware_profile.json"
    p.write_text(json.dumps(data), encoding="utf-8")
    return p


def make_profile(facts: dict) -> HardwareProfile:
    """Build a HardwareProfile from a dict of fact-name -> HardwareFact."""
    return HardwareProfile(facts)


# --------------------------------------------------------------------------- missing profile file


class TestMissingProfile(unittest.TestCase):
    """A missing profile file must default to fail-closed."""

    def test_missing_profile_returns_empty(self):
        profile = HardwareProfile.from_file(Path(tempfile.mkdtemp()) / "nonexistent.json")
        self.assertEqual(len(profile.facts), 0)
        # Every assumption must be blocked.
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)
        self.assertIn("U1", result.blocking_assumptions)
        self.assertIn("U2", result.blocking_assumptions)
        self.assertIn("U3", result.blocking_assumptions)
        self.assertIn("U7", result.blocking_assumptions)

    def test_missing_profile_blocks_mechanical(self):
        profile = HardwareProfile.from_file(Path(tempfile.mkdtemp()) / "nonexistent.json")
        result = gate_mechanical_footprint(profile)
        self.assertFalse(result.allowed)
        self.assertEqual(set(result.blocking_assumptions), {"U4", "U5", "U6"})

    def test_missing_profile_blocks_fabrication(self):
        profile = HardwareProfile.from_file(Path(tempfile.mkdtemp()) / "nonexistent.json")
        result = gate_fabrication_release(profile)
        self.assertFalse(result.allowed)
        self.assertEqual(set(result.blocking_assumptions), {"U1", "U2", "U3", "U4", "U5", "U6", "U7"})


