# --------------------------------------------------------------------------- invalid schema


class TestInvalidSchema(unittest.TestCase):
    """Invalid profile schema must raise ValueError."""

    def test_non_dict_root_raises(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            p = Path(tmpdir) / "bad.json"
            p.write_text('[1, 2, 3]', encoding="utf-8")
            with self.assertRaises(ValueError):
                HardwareProfile.from_file(p)

    def test_invalid_json_raises(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            p = Path(tmpdir) / "bad.json"
            p.write_text("{not valid json", encoding="utf-8")
            with self.assertRaises(ValueError):
                HardwareProfile.from_file(p)

    def test_invalid_confidence_raises(self):
        with self.assertRaises(ValueError):
            HardwareFact(confidence="not_a_valid_confidence")

    def test_non_dict_entry_raises(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            p = Path(tmpdir) / "bad.json"
            p.write_text(json.dumps({"U1": "just_a_string"}), encoding="utf-8")
            with self.assertRaises(ValueError):
                HardwareProfile.from_file(p)


# --------------------------------------------------------------------------- bypass attempts


class TestBypassAttempts(unittest.TestCase):
    """A skip_gates flag or arbitrary override must not bypass a blocked gate."""

    def test_skip_gates_flag_ignored(self):
        # Even if a caller passes skip_gates=True, the gate function itself
        # does not accept or honor such a flag — it always checks facts.
        profile = make_profile({"U1": HardwareFact(confidence=CONFIDENCE_UNRESOLVED)})
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)
        self.assertIn("U1", result.blocking_assumptions)

    def test_user_confirmation_does_not_override_unverified(self):
        # Gate functions have no user_confirmation parameter; facts determine
        # the outcome. An unresolved fact blocks regardless of any external
        # confirmation.
        profile = make_profile({"U1": HardwareFact(confidence=CONFIDENCE_UNRESOLVED)})
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)

    def test_conflict_not_overridable(self):
        profile = make_profile({
            "U1": HardwareFact(
                confidence=CONFIDENCE_CONFLICTING,
                value="3.3V",
                source="prompt_extract",
            ),
        })
        result = gate_electrical_schematic(profile)
        self.assertFalse(result.allowed)
        self.assertGreaterEqual(len(result.conflicts), 1)


# --------------------------------------------------------------------------- gate structure


class TestGateStructure(unittest.TestCase):
    """Gate results must have the required structure."""

    def test_gate_result_fields(self):
        profile = make_profile({})
        result = gate_electrical_schematic(profile)
        self.assertIsInstance(result, GateResult)
        self.assertIsInstance(result.allowed, bool)
        self.assertIsInstance(result.blocking_assumptions, list)
        self.assertIsInstance(result.conflicts, list)
        self.assertIsInstance(result.reason, str)

    def test_gate_all_returns_all_three(self):
        profile = make_profile({})
        results = gate_all(profile)
        self.assertIn("electrical_schematic", results)
        self.assertIn("mechanical_footprint", results)
        self.assertIn("fabrication_release", results)
        self.assertIsInstance(results["electrical_schematic"], GateResult)
        self.assertIsInstance(results["mechanical_footprint"], GateResult)
        self.assertIsInstance(results["fabrication_release"], GateResult)


# --------------------------------------------------------------------------- hardware fact validation


class TestHardwareFact(unittest.TestCase):
    """HardwareFact validation."""

    def test_valid_confidences(self):
        for conf in (CONFIDENCE_VERIFIED, CONFIDENCE_ASSUMED,
                     CONFIDENCE_UNRESOLVED, CONFIDENCE_CONFLICTING):
            fact = HardwareFact(confidence=conf)
            self.assertEqual(fact.confidence, conf)

    def test_invalid_confidence_raises(self):
        with self.assertRaises(ValueError):
            HardwareFact(confidence="invalid")

    def test_default_confidence_is_unresolved(self):
        fact = HardwareFact()
        self.assertEqual(fact.confidence, CONFIDENCE_UNRESOLVED)

    def test_affects_decisions_defaults_to_empty(self):
        fact = HardwareFact()
        self.assertEqual(fact.affects_decisions, [])


# --------------------------------------------------------------------------- profile loading from file


class TestProfileFileLoading(unittest.TestCase):
    """Loading profiles from JSON files."""

    def test_load_valid_profile(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            p = write_profile(tmpdir, {
                "U1": {
                    "value": "3.3V-5V",
                    "source": "datasheet",
                    "confidence": "verified",
                    "affects_decisions": ["supply_net_selection"],
                },
            })
            profile = HardwareProfile.from_file(p)
            fact = profile.fact("U1")
            self.assertIsNotNone(fact)
            self.assertEqual(fact.value, "3.3V-5V")
            self.assertEqual(fact.confidence, CONFIDENCE_VERIFIED)

    def test_load_profile_with_all_assumptions(self):
        with tempfile.TemporaryDirectory() as tmpdir:
            p = write_profile(tmpdir, {
                "U1": {"confidence": "verified"},
                "U2": {"confidence": "verified"},
                "U3": {"confidence": "verified"},
                "U7": {"confidence": "verified"},
                "U4": {"confidence": "verified"},
                "U5": {"confidence": "verified"},
                "U6": {"confidence": "verified"},
            })
            profile = HardwareProfile.from_file(p)
            result = gate_electrical_schematic(profile)
            self.assertTrue(result.allowed)
            result = gate_mechanical_footprint(profile)
            self.assertTrue(result.allowed)


